generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  createdAt DateTime       @default(now())
  password  String
  role      Role           @default(USER)
  updatedAt DateTime       @updatedAt
  firstName String
  lastName  String
  isActive  Boolean        @default(true)
  emotions  EmotionEntry[]
  resources Resource[]
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  readingTime Int
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubEmotion {
  id        String   @id @default(cuid())
  label     String
  kind      String
  createdAt DateTime @default(now())
}

model EmotionEntry {
  id         String   @id @default(cuid())
  date       DateTime
  kind       String
  subEmotion String
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}
