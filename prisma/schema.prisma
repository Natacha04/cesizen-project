generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  firstName String
  lastName  String
  password  String
  role      Role           @default(USER)
  resources Resource[]
  emotions  EmotionEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  readingTime Int
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model EmotionEntry {
  id         String   @id @default(cuid())
  date       DateTime
  kind       String
  subEmotion String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
